---
const currentYear = new Date().getFullYear();
---

<footer class="footer-component border-t" role="contentinfo">
  <!-- UW Gold accent bar -->
  <div class="h-1 bg-uw-gold"></div>

  <div class="max-w-[1200px] mx-auto px-4 py-4 md:py-8">
    <!-- Footer content - single row with logo, toggle centered, and copyright -->
    <div class="flex flex-col lg:flex-row justify-between items-center gap-2 lg:gap-4">
      <!-- Left: Logo and links -->
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
        <a href="/" class="inline-block py-2">
          <img src="/images/shendurelab.png" alt="Shendure Lab" class="h-6 md:h-8 bg-white px-2 py-1 rounded" />
        </a>
        <span class="text-xs md:text-sm footer-text text-center md:text-left">
          <a href="https://www.gs.washington.edu/" target="_blank" rel="noopener noreferrer" class="hover:text-uw-purple hover:underline inline-block py-2">Genome Sciences<span class="sr-only"> (opens in new tab)</span></a> | <a href="https://www.washington.edu/" target="_blank" rel="noopener noreferrer" class="hover:text-uw-purple hover:underline inline-block py-2">UW<span class="sr-only"> (opens in new tab)</span></a>
        </span>
      </div>

      <!-- Center: Theme Toggle -->
      <button
        id="theme-toggle"
        class="flex items-center gap-3 text-base footer-text hover:text-uw-purple transition-colors order-first lg:order-none mb-2 lg:mb-0 px-6 py-3 rounded-lg"
        aria-label="Toggle dark mode"
      >
        <svg id="theme-icon-light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-dark" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span id="theme-label">Dark</span>
      </button>

      <!-- Right: Copyright -->
      <div class="text-sm footer-text-muted text-center lg:text-right">
        <p>&copy; {currentYear} Shendure Lab</p>
        <p class="text-xs footer-text-extra-muted">Designed by Olga Oseth with Charlie Lee, built with Claude</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-component {
    background-color: var(--theme-bg);
    border-color: var(--theme-border);
  }
  .footer-text {
    color: var(--theme-text-secondary);
  }
  .footer-text-muted {
    color: var(--theme-text-muted);
  }
  .footer-text-extra-muted {
    color: #848a94;
  }
  :global(.dark) .footer-text-extra-muted {
    color: #8b95a3;
  }
  #theme-toggle:hover,
  #theme-toggle:focus-visible {
    background-color: var(--theme-bg-secondary);
  }
</style>

<script>
  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    const iconLight = document.getElementById('theme-icon-light');
    const iconDark = document.getElementById('theme-icon-dark');
    const label = document.getElementById('theme-label');

    function updateIcons(isDark: boolean) {
      if (isDark) {
        iconLight?.classList.remove('hidden');
        iconDark?.classList.add('hidden');
        if (label) label.textContent = 'Light';
      } else {
        iconLight?.classList.add('hidden');
        iconDark?.classList.remove('hidden');
        if (label) label.textContent = 'Dark';
      }
    }

    // Check current state
    const isDark = document.documentElement.classList.contains('dark');
    updateIcons(isDark);

    toggle?.addEventListener('click', () => {
      const currentlyDark = document.documentElement.classList.contains('dark');
      if (currentlyDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
        updateIcons(false);
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
        updateIcons(true);
      }
    });
  }

  // Run on initial load
  initTheme();

  // Re-run on page navigation (for Astro view transitions if used)
  document.addEventListener('astro:page-load', initTheme);
</script>
