---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YearNavScript from '../../components/shared/YearNavScript.astro';
import fs from 'fs';
import path from 'path';

// Load preprint publications
const publicationsDir = path.join(process.cwd(), 'src/content/publications');
const files = fs.readdirSync(publicationsDir).filter(f => f.endsWith('.json') && !f.startsWith('_'));
const publications = files.map(f => {
  const content = fs.readFileSync(path.join(publicationsDir, f), 'utf-8');
  return JSON.parse(content);
}).filter(p => p.category === 'preprint')
  .sort((a, b) => (a.sortOrder ?? 999) - (b.sortOrder ?? 999));

// Group publications by year
const publicationsByYear = publications.reduce((acc, pub) => {
  const year = pub.year || 'Unknown';
  if (!acc[year]) acc[year] = [];
  acc[year].push(pub);
  return acc;
}, {} as Record<string | number, typeof publications>);

// Get sorted years (most recent first)
const years = Object.keys(publicationsByYear).sort((a, b) => Number(b) - Number(a));

// Helper to parse citation
function parseCitation(citation) {
  // Format: "Authors. Title bioRxiv DOI (Year)"
  const match = citation.match(/^(.+?)\.\s*(.+?)\s*bioRxiv\s*([\d.]+)\s*\((\d{4})\)$/);
  if (match) {
    return {
      authors: match[1].trim(),
      title: match[2].trim(),
      doi: match[3].trim(),
      year: match[4]
    };
  }
  return { authors: citation, title: '', doi: '', year: '' };
}

// Format collaboration text
function formatCollaboration(collab) {
  return collab || null;
}
---

<BaseLayout title="Featured Preprints | Shendure Lab">
  <!-- Mobile Year Scrollbar -->
  <nav class="lg:hidden sticky top-16 z-40 year-scrollbar border-b" aria-label="Jump to year">
    <div class="flex overflow-x-auto scrollbar-hide px-4 py-2 gap-2" role="list">
      {years.map(year => (
        <a
          href={`#year-${year}`}
          class="year-pill flex-shrink-0 px-4 py-3 text-sm rounded-full border transition-colors"
          role="listitem"
          aria-label={`Jump to ${year} publications`}
        >
          {year}
        </a>
      ))}
    </div>
  </nav>

  <div class="w-full max-w-[1000px] mx-auto px-4 py-12 pb-[60vh]">
    <h1 class="w-full text-2xl md:text-3xl font-bold text-lab-orange mb-8 text-center">Featured Preprint Papers</h1>
    <p class="w-full text-center pub-subtitle mb-10">(work led or co-led by our lab)</p>

    {years.map(year => (
      <div id={`year-${year}`} class="mb-12 scroll-mt-32">
        <h2 class="text-xl font-bold text-lab-orange mb-6 text-center lg:text-left">{year}</h2>
        <div class="space-y-6">
          {publicationsByYear[year].map(pub => {
            const parsed = parseCitation(pub.citation);
            return (
              <div id={pub.slug} class="preprint-card border-b pb-4 px-3 py-2 rounded-lg transition-all duration-300">
                <p class="preprint-text text-base">
                  {pub.articleUrl ? (
                    <a href={pub.articleUrl} target="_blank" rel="noopener noreferrer" class="text-lab-blue hover:underline">
                      {parsed.authors}. {parsed.title}<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  ) : (
                    <>{parsed.authors}. {parsed.title}</>
                  )}
                </p>
                <p class="preprint-meta text-sm mt-1">
                  <em>bioRxiv</em> {parsed.doi} ({parsed.year})
                </p>
                {pub.postedDate && (
                  <p class="text-sm preprint-muted mt-1">Posted: {pub.postedDate}</p>
                )}
                {pub.collaboration && (
                  <p class="text-sm preprint-meta mt-1">({formatCollaboration(pub.collaboration)})</p>
                )}
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <style>
    :global(.preprint-card.highlighted) {
      background-color: rgba(237, 148, 60, 0.15);
      box-shadow: 0 0 0 3px rgba(237, 148, 60, 0.4);
    }
    .preprint-card {
      border-color: var(--theme-border);
    }
    .preprint-text {
      color: var(--theme-text-secondary);
    }
    .preprint-meta {
      color: var(--theme-text-secondary);
    }
    .preprint-muted {
      color: var(--theme-text-muted);
    }
    .year-scrollbar {
      background-color: var(--theme-bg);
      border-color: var(--theme-border);
    }
    .year-pill {
      background-color: var(--theme-bg);
      border-color: var(--theme-border);
      color: var(--theme-text-secondary);
    }
    .year-pill:hover, .year-pill:focus-visible, .year-pill.active {
      background-color: var(--color-lab-orange);
      border-color: var(--color-lab-orange);
      color: white;
    }
    .pub-subtitle {
      color: var(--theme-text-secondary);
    }
  </style>

  <YearNavScript />

  <script>
    function highlightCard() {
      const hash = window.location.hash.slice(1);
      if (!hash) return;

      document.querySelectorAll('.preprint-card.highlighted').forEach(el => {
        el.classList.remove('highlighted');
      });

      const card = document.getElementById(hash);
      if (card) {
        setTimeout(() => {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.classList.add('highlighted');

          setTimeout(() => {
            card.classList.remove('highlighted');
          }, 5000);
        }, 100);
      }
    }

    highlightCard();
    window.addEventListener('hashchange', highlightCard);
  </script>
</BaseLayout>
