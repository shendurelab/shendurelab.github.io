// Add year to each photo based on title
const photosWithYears = photos.map(photo => {
  if (photo.year) return photo;
  const match = photo.title.match(/\b(20\d{2})\b/);
  return { ...photo, year: match ? parseInt(match[1]) : 2020 };
});

// Group by year
const photosByYear: Record<number, typeof photos> = {};
photosWithYears.forEach(photo => {
  if (!photosByYear[photo.year]) photosByYear[photo.year] = [];
  photosByYear[photo.year].push(photo);
});

// Get years sorted descending
const years = Object.keys(photosByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="Fun | Shendure Lab">
  <!-- Mobile Year Scrollbar -->
  <nav class="md:hidden sticky top-16 z-40 year-scrollbar border-b" aria-label="Jump to year">
    <div class="flex overflow-x-auto scrollbar-hide px-4 py-2 gap-2" role="list">
      {years.map(year => (
        <a
          href={`#year-${year}`}
          class="year-pill flex-shrink-0 px-4 py-3 text-sm rounded-full border transition-colors"
          role="listitem"
          aria-label={`Jump to ${year} photos`}
        >
          {year}
        </a>
      ))}
    </div>
  </nav>

  <div class="w-full max-w-[1200px] mx-auto px-4 py-12">
    <h1 class="w-full text-3xl font-bold text-lab-orange mb-8 text-center">Fun</h1>

    <div class="flex gap-8">
      <!-- Main Content — pb-[60vh] ensures bottom sections can scroll to top when clicked -->
      <div class="flex-grow space-y-16 pb-[60vh]">
        {years.map(year => (
          <section id={`year-${year}`} class="scroll-mt-32">
            <h2 class="text-2xl font-bold text-uw-purple mb-6 border-b-2 border-uw-gold pb-2">{year}</h2>
            <div class="space-y-10">
              {photosByYear[year].map(photo => (
                <div class="text-center">
                  <h3 class="text-lg font-semibold photo-title mb-2">{photo.title}</h3>
                  {photo.subtitle && (
                    <p class="photo-subtitle mb-3">{photo.subtitle}</p>
                  )}

                  {photo.image ? (
                    <a href={photo.albumUrl || photo.image} target="_blank" rel="noopener noreferrer" class="block">
                      <img
                        src={photo.image}
                        alt={photo.title}
                        class="max-w-full mx-auto rounded-lg shadow-md hover:shadow-xl transition-shadow"
                        style={`max-height: ${photo.maxHeight ?? 600}px; width: auto;`}
                        loading="lazy"
                      />
                      <span class="sr-only">(opens in new tab)</span>
                    </a>
                  ) : photo.albumUrl && (
                    <a href={photo.albumUrl} target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-3 bg-lab-blue text-white rounded-lg hover:bg-blue-700 transition-colors">
                      View Photo Album<span class="sr-only"> (opens in new tab)</span>
                    </a>
                  )}

                  {photo.credit && (
                    <p class="photo-credit mt-2">{photo.credit}</p>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Year Navigation Sidebar -->
      <nav class="hidden md:block w-32 flex-shrink-0" aria-label="Year navigation">
        <div class="sticky top-24 space-y-3">
          <p class="text-sm sidebar-label uppercase tracking-wider mb-4 pl-4 font-semibold">Years</p>
          {years.map(year => (
            <a
              href={`#year-${year}`}
              data-year={year}
              class="year-link block px-4 py-4 text-lg font-medium sidebar-link rounded-lg transition-colors"
              aria-label={`Jump to ${year} photos`}
            >
              {year}
            </a>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-16 text-center">
      <a
        href="https://www.tiktok.com/@chasesuiter310/video/7145303014876761386"
        target="_blank"
        rel="noopener noreferrer"
        class="text-lab-blue hover:underline"
      >
        Get to know Shendure Lab - video by Chase Suiter (2022)<span class="sr-only"> (opens in new tab)</span>
      </a>
    </div>
  </div>

  <style>
    .year-link.active {
      background-color: #ED943C;
      color: white;
    }
    .year-link.active:hover {
      background-color: #d4832f;
      color: white;
    }
    .year-scrollbar {
      background-color: var(--theme-bg);
      border-color: var(--theme-border);
    }
    .year-pill {
      background-color: var(--theme-bg);
      border-color: var(--theme-border);
      color: var(--theme-text-secondary);
    }
    .year-pill:hover, .year-pill:focus-visible, .year-pill.active {
      background-color: var(--color-lab-orange);
      border-color: var(--color-lab-orange);
      color: white;
    }
    .photo-title {
      color: var(--theme-text);
    }
    .photo-subtitle {
      color: var(--theme-text-secondary);
    }
    .photo-credit {
      color: var(--theme-text-muted);
    }
    .sidebar-label {
      color: var(--theme-text-muted);
    }
    .sidebar-link {
      color: var(--theme-text-secondary);
    }
    .sidebar-link:hover {
      color: var(--color-lab-orange);
      background-color: rgba(237, 148, 60, 0.1);
    }
  </style>

  <YearNavScript />
</BaseLayout>
