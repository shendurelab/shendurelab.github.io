---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonCard from '../../components/people/PersonCard.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load people data
const peopleDir = path.join(process.cwd(), 'src/content/people');
const files = fs.readdirSync(peopleDir).filter(f => f.endsWith('.json') && !f.startsWith('_'));

const allPeople = files.map(f => {
  const content = fs.readFileSync(path.join(peopleDir, f), 'utf-8');
  return JSON.parse(content);
});

// Filter alumni only
const alumni = allPeople.filter(p => p.status === 'alumni');

// Sort by sortOrder (if exists), then by end year, then by last name
const sortedAlumni = [...alumni].sort((a, b) => {
  const aOrder = a.sortOrder ?? 9999;
  const bOrder = b.sortOrder ?? 9999;
  if (aOrder !== bOrder) return aOrder - bOrder;
  const aYear = a.endYear ?? 0;
  const bYear = b.endYear ?? 0;
  if (bYear !== aYear) return bYear - aYear;
  const aLast = a.name.split(' ').pop() || '';
  const bLast = b.name.split(' ').pop() || '';
  return aLast.localeCompare(bLast);
});

// Helper to create slug from name (must match the logic in update-search.cjs)
function slugify(name: string): string {
  return name.toLowerCase().replace(/[()]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
---

<BaseLayout title="Alumni" description="Former members of the Shendure Lab">
