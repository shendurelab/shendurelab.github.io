    { image: 'iossifov_nature_2014_thumb.png', articleUrl: 'http://www.nature.com/nature/journal/v515/n7526/full/nature13908.html', authors: "Iossifov, O'Roak, Sanders, Ronemus et al.", title: 'The contribution of de novo coding mutations to autism spectrum disorder', journal: 'Nature', year: 2014, pmid: '25363768', pdfFile: 'iossifov_nature_2014.pdf', collaboration: 'with Wigler, State and Eichler Labs' },
  ],
  [
    { image: 'kircher_nature_genetics_2014_thumb.jpg', articleUrl: 'http://www.nature.com/ng/journal/vaop/ncurrent/full/ng.2892.html', authors: 'Kircher, Witten et al.', title: 'A general framework for estimating the relative pathogenicity of human genetic variants', journal: 'Nature Genetics', year: 2014, pmid: '24487276', pdfFile: 'kircher_nature_genetics_2014.pdf', collaboration: 'with Cooper Lab' },
    { image: 'kumar_plos_one_2014_thumb.jpg', articleUrl: 'http://www.plosone.org/article/info%3Adoi%2F10.1371%2Fjournal.pone.0106744', authors: 'Kumar et al.', title: 'Genome sequencing of idiopathic pulmonary fibrosis in conjunction with a medical school human anatomy course', journal: 'PLoS One', year: 2014, pmid: '25192356', pdfFile: 'kumar_plos_one_2014.pdf' },
    { image: 'oroak_nature_2012_thumb.png', articleUrl: 'http://www.nature.com/nature/journal/v485/n7397/full/nature10989.html', authors: "O'Roak et al.", title: 'Sporadic autism exomes reveal a highly interconnected protein network of de novo mutations', journal: 'Nature', year: 2012, pmid: '22495309', pdfFile: 'oroak_nature_2012.pdf', collaboration: 'with Eichler Lab' },
  ],
  [
    { image: 'oroak_science_2012_thumb.jpg', articleUrl: 'http://www.sciencemag.org/content/338/6114/1619.full', authors: "O'Roak et al.", title: 'Multiplex Targeted Sequencing Identifies Recurrently Mutated Genes in Autism Spectrum Disorders', journal: 'Science', year: 2012, pmid: '23160955', pdfFile: 'oroak_science_2012.pdf', collaboration: 'with Eichler Lab' },
    { image: 'bamshad_nrg_2011_thumb.jpg', articleUrl: 'http://www.nature.com/nrg/journal/v12/n11/full/nrg3031.html', authors: 'Bamshad et al.', title: 'Exome sequencing as a tool for Mendelian disease gene discovery', journal: 'Nature Reviews Genetics', year: 2011, pmid: '21946919', pdfFile: 'bamshad_nrg_2011.pdf' },
    { image: 'cooper_nrg_2011_thumb.jpg', articleUrl: 'http://www.nature.com/nrg/journal/v12/n9/full/nrg3046.html', authors: 'Cooper, Shendure', title: 'Needles in stacks of needles: finding disease-causal variants in a wealth of genomic data', journal: 'Nature Reviews Genetics', year: 2011, pmid: '21850043', pdfFile: 'cooper_nrg_2011.pdf' },
  ],
  [
    { image: 'kumar_pnas_2011_thumb.jpg', articleUrl: 'http://www.pnas.org/content/early/2011/09/22/1108745108.full.pdf+html', authors: 'Kumar et al.', title: 'Exome sequencing identifies a spectrum of mutation frequencies in advanced and lethal prostate cancers', journal: 'PNAS', year: 2011, pmid: '21949389', pdfFile: 'kumar_pnas_2011.pdf', collaboration: 'with Nelson Lab' },
    { image: 'shendure_genome_biology_2011_thumb.jpg', articleUrl: 'http://genomebiology.com/content/pdf/gb-2011-12-9-408.pdf', authors: 'Shendure', title: 'Next-generation human genetics', journal: 'Genome Biology', year: 2011, pmid: '21920048', pdfFile: 'shendure_genome_biology_2011.pdf' },
    { image: 'oroak_nature_genetics_2011_thumb.jpg', articleUrl: 'http://www.nature.com/ng/journal/v43/n6/full/ng.835.html', authors: "O'Roak et al.", title: 'Exome sequencing in sporadic autism spectrum disorders identifies severe de novo mutations', journal: 'Nature Genetics', year: 2011, pmid: '21572417', pdfFile: 'oroak_nature_genetics_2011.pdf', collaboration: 'with Eichler Lab' },
  ],
  [
    { image: 'ng_nature_genetics_2010a_thumb.jpg', articleUrl: 'http://www.nature.com/ng/journal/v42/n1/full/ng.499.html', authors: 'Ng, Bigham et al.', title: 'Exome sequencing identifies the cause of a mendelian disorder', journal: 'Nature Genetics', year: 2010, pmid: '19915526', pdfFile: 'ng_nature_genetics_2010a.pdf', collaboration: 'with Bamshad Lab' },
    { image: 'ng_nature_genetics_2010b_thumb.jpg', articleUrl: 'http://www.nature.com/ng/journal/v42/n9/full/ng.646.html', authors: 'Ng, Bigham et al.', title: 'Exome sequencing identifies MLL2 mutations as a cause of Kabuki syndrome', journal: 'Nature Genetics', year: 2010, pmid: '20711175', pdfFile: 'ng_nature_genetics_2010b.pdf', collaboration: 'with Bamshad Lab' },
    { image: 'ng_nature_2009_thumb.jpg', articleUrl: 'http://www.nature.com/nature/journal/v461/n7261/full/nature08250.html', authors: 'Ng et al.', title: 'Targeted capture and massively parallel sequencing of 12 human exomes', journal: 'Nature', year: 2009, pmid: '19684571', pdfFile: 'ng_nature_2009.pdf' },
  ],
];

// Flatten and group by year
const allPubs = publicationRows.flat();
const pubsByYear = allPubs.reduce((acc, pub) => {
  const year = pub.year || 'Unknown';
  if (!acc[year]) acc[year] = [];
  acc[year].push(pub);
  return acc;
}, {} as Record<number | string, typeof allPubs>);

// Get sorted years (most recent first)
const years = Object.keys(pubsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Genetic Basis of Human Disease | Shendure Lab">
  <!-- Mobile Year Scrollbar -->
  <nav class="lg:hidden sticky top-16 z-40 year-scrollbar border-b" aria-label="Jump to year">
    <div class="flex overflow-x-auto scrollbar-hide px-4 py-2 gap-2" role="list">
      {years.map(year => (
        <a
          href={`#year-${year}`}
          class="year-pill flex-shrink-0 px-4 py-3 text-sm rounded-full border transition-colors"
          role="listitem"
          aria-label={`Jump to ${year} publications`}
        >
          {year}
        </a>
      ))}
    </div>
  </nav>

  <div class="w-full max-w-[1000px] mx-auto px-4 py-12 pb-[60vh]">
    <h1 class="w-full text-2xl md:text-3xl font-bold text-lab-orange mb-8 text-center">Genetic Basis of Human Disease</h1>
    <p class="w-full text-center page-subtitle mb-10">(selected publications)</p>

    <div class="w-full mb-8 text-center">
      <a href="/research" class="text-lab-blue hover:underline">&larr; Back to Research</a>
    </div>

    {years.map(year => (
      <div id={`year-${year}`} class="mb-12 scroll-mt-32">
        <h2 class="text-xl font-bold text-lab-orange mb-6 text-center lg:text-left">{year}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 justify-items-center">
          {pubsByYear[year].map((pub) => (
            <ResearchPubCard
              image={pub.image}
              articleUrl={pub.articleUrl}
              authors={pub.authors}
              title={pub.title}
              journal={pub.journal}
              year={pub.year}
              pmid={pub.pmid}
              pdfFile={pub.pdfFile}
              collaboration={pub.collaboration}
            />
          ))}
        </div>
      </div>
    ))}
  </div>

  <YearNavScript />
</BaseLayout>

<style>
  .year-scrollbar {
    background-color: var(--theme-bg);
    border-color: var(--theme-border);
  }
  .year-pill {
    background-color: var(--theme-bg);
    border-color: var(--theme-border);
    color: var(--theme-text-secondary);
  }
  .year-pill:hover, .year-pill:focus-visible {
    background-color: var(--color-lab-orange);
    border-color: var(--color-lab-orange);
    color: white;
  }
  .page-subtitle {
    color: var(--theme-text-secondary);
  }
</style>
