  ],
  [
    { image: 'hause_nature_medicine_2017_thumb.jpg', articleUrl: 'http://www.nature.com/nm/journal/v22/n11/full/nm.4191.html', authors: 'Hause et al.', title: 'Classification and characterization of microsatellite instability across 18 cancer types', journal: 'Nature Medicine', year: 2016, pmid: '27694933', pdfFile: 'hause_nature_medicine_2016.pdf', collaboration: 'with Salipante Lab' },
    { image: 'kumar_nature_medicine_2016_thumb.png', articleUrl: 'http://www.nature.com/nm/journal/v22/n4/abs/nm.4053.html', authors: 'Kumar, Coleman et al.', title: 'Substantial interindividual and limited intraindividual genomic diversity among tumors from men with metastatic prostate cancer', journal: 'Nature Medicine', year: 2016, pmid: '26928463', pdfFile: 'kumar_nature_medicine_2016.pdf', collaboration: 'with Nelson Lab' },
