---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchPubCard from '../../components/research/ResearchPubCard.astro';
import YearNavScript from '../../components/shared/YearNavScript.astro';

const publicationRows = [
  [
    { image: 'Simeonov_cancerCell_2021_thumb(2).png', articleUrl: 'https://www.cell.com/cancer-cell/fulltext/S1535-6108(21)00271-3', authors: 'Simeonov et al.', title: 'Single-cell lineage tracing of metastatic cancer reveals selection of hybrid EMT states', journal: 'Cancer Cell', year: 2021, pmid: '34115987', pdfFile: 'Simeonov_cancerCell_2021(correctpaper).pdf', collaboration: 'with Lengner and McKenna Labs' },
    { image: 'kircher_nature_communications_2019 thumbnail.jpg', articleUrl: 'https://www.nature.com/articles/s41467-019-11526-w', authors: 'Kircher, Xiong, Martin, Schubach et al.', title: 'Saturation mutagenesis of twenty disease-associated regulatory elements at single base-pair resolution', journal: 'Nature Communications', year: 2019, pmid: '31395865', pdfFile: 'kircher_nature_communications_2019.pdf', collaboration: 'with Ahituv and Kircher Labs' },
    { image: 'klein_nature_2019_thumb.jpg', articleUrl: 'https://www.nature.com/articles/s41467-019-10439-y', authors: 'Klein et al.', title: 'Functional testing of thousands of osteoarthritis-associated variants for regulatory activity', journal: 'Nature Communications', year: 2019, pmid: '31164647', pdfFile: 'klein_nature_2019.pdf' },
  ],
  [
    { image: 'rentzsch_nucleic_2019.png', articleUrl: 'https://academic.oup.com/nar/article/47/D1/D886/5146191', authors: 'Rentzsch et al.', title: 'CADD: predicting the deleteriousness of variants throughout the human genome', journal: 'Nucleic Acids Research', year: 2019, pmid: '30371827', pdfFile: 'rentzsch_nucleic_2019.pdf', collaboration: 'with Kircher Lab' },
    { image: 'findlay_nature_2018_thumb.png', articleUrl: 'https://www.nature.com/articles/s41586-018-0461-z', authors: 'Findlay et al.', title: 'Accurate classification of BRCA1 variants with saturation genome editing', journal: 'Nature', year: 2018, pmid: '30209399', pdfFile: 'findlay_nature_2018.pdf', collaboration: 'with Starita Lab' },
    { image: 'starita_ajhg_2018_thumb.png', articleUrl: 'https://www.sciencedirect.com/science/article/pii/S000292971830243X', authors: 'Starita et al.', title: 'A Multiplex Homology-Directed DNA Repair Assay Reveals the Impact of More Than 1,000 BRCA1 Missense Substitution Variants on Protein Function', journal: 'AJHG', year: 2018, pmid: '30219179', pdfFile: 'starita_ajhg_2018.pdf', collaboration: 'with Parvin Lab' },
  ],
