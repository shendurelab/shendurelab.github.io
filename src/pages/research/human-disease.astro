    { image: 'cusanovich_cell_2018.png', articleUrl: 'https://www.cell.com/cell/abstract/S0092-8674(18)30855-9', authors: 'Cusanovich, Hill et al.', title: 'A Single-Cell Atlas of In Vivo Mammalian Chromatin Accessibility', journal: 'Cell', year: 2018, pmid: '30078704', pdfFile: 'cusanovich_cell_2018.pdf', collaboration: 'with Trapnell Lab' },
    { image: 'gasperini_AJHG_2017_thumb.jpg', articleUrl: 'http://www.sciencedirect.com/science/article/pii/S0002929717302458', authors: 'Gasperini, Findlay et al.', title: 'CRISPR/Cas9-Mediated Scanning for Regulatory Elements Required for HPRT1 Expression via Thousands of Large, Programmed Genomic Deletions', journal: 'AJHG', year: 2017, pmid: '28712454', pdfFile: 'gasperini_ajhd_2017.pdf' },
