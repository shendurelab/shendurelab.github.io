  ],
  [
    { image: 'shendure_science_2015_thumb.jpg', articleUrl: 'http://science.sciencemag.org/content/349/6255/1478', authors: 'Shendure, Akey', title: 'The origins, determinants, and consequences of human mutations', journal: 'Science', year: 2015, pmid: '26404824', pdfFile: 'shendure_science_2015.pdf' },
