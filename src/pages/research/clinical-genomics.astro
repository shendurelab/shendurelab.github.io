    { image: 'neveling_clinical_chemistry_2017_thumb.jpg', articleUrl: 'http://clinchem.aaccjnls.org/content/63/2/503.long', authors: 'Neveling, Mensenkamp et al.', title: 'BRCA Testing by Single-Molecule Molecular Inversion Probes', journal: 'Clinical Chemistry', year: 2017, pmid: '27974384', pdfFile: 'neveling_clinical_chem_2017.pdf', collaboration: 'with Nelen, Hoischen Labs' },
