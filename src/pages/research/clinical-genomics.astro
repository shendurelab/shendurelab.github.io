  [
    { image: 'salipante_genome_research_2014_thumb.jpg', articleUrl: 'http://genome.cshlp.org/content/early/2014/12/01/gr.180190.114.long', authors: 'Salipante, Roach et al.', title: 'Large-scale genomic sequencing of extraintestinal pathogenic Escherichia coli strains', journal: 'Genome Research', year: 2014, pmid: '25373147', pdfFile: 'salipante_genome_research_2014.pdf' },
    { image: 'kumar_genome_biology_2014_thumb.jpg', articleUrl: 'http://www.genomebiology.com/content/15/12/530', authors: 'Kumar et al.', title: 'Deep sequencing of multiple regions of glial tumors reveals spatial heterogeneity for mutations in clinically relevant genes', journal: 'Genome Biology', year: 2014, pmid: '25608559', pdfFile: 'kumar_genome_biology_2014.pdf', collaboration: 'with Rostomily Lab' },
