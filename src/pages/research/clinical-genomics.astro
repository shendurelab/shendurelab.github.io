    { image: 'srivatsan_science_2020_thumb.jpg', articleUrl: 'https://science.sciencemag.org/content/367/6473/45.long', authors: 'Srivatsan, McFaline-Figueroa, Ramani et al.', title: 'Massively multiplex chemical transcriptomics at single-cell resolution', journal: 'Science', year: 2020, pmid: '31806696', pdfFile: 'srivatsan_science_2020.pdf', collaboration: 'with Trapnell Lab' },
