  ],
  [
    { image: 'starita_genetics_2015_thumb.jpg', articleUrl: 'http://genetics.org/content/200/2/413.long', authors: 'Starita et al.', title: 'Massively Parallel Functional Analysis of BRCA1 RING Domain Variants', journal: 'Genetics', year: 2015, pmid: '25823446', pdfFile: 'starita_genetics_2015.pdf', collaboration: 'with Fields Lab' },
    { image: 'snyder_nejm_2015_thumb.png', articleUrl: 'http://www.nejm.org/doi/full/10.1056/NEJMoa1408408', authors: 'Snyder, Simmons et al.', title: 'Copy-Number Variation and False Positive Prenatal Aneuploidy Screening Results', journal: 'New England Journal of Medicine', year: 2015, pmid: '25830323', pdfFile: 'snyder_nejm_2015.pdf', collaboration: 'with Gammill Lab' },
