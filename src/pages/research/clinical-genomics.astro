    { image: 'choi_nature_2022_thumb.png', articleUrl: 'https://www.nature.com/articles/s41587-021-01025-z', authors: 'Choi, Chen et al.', title: 'Precise genomic deletions using paired prime editing', journal: 'Nature Biotechnology', year: 2022, pmid: '34650269', pdfFile: 'choi_natureBiotech_2022.pdf' },
    { image: 'Srivatsan_ClinicalChemistry_2022_thumb.png', articleUrl: 'https://academic.oup.com/clinchem/article/68/1/143/6323225', authors: 'Srivatsan et al.', title: 'SwabExpress: An end-to-end protocol for extraction-free COVID-19 testing', journal: 'Clinical Chemistry', year: 2021, pmid: '32511368', pdfFile: 'Srivatsan_ClinicalChemistry_2022.pdf', collaboration: 'with Seattle Flu Study' },
  ],
