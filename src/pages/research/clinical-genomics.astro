  [
    { image: 'snyder_cell_2016_thumb.jpg', articleUrl: 'http://www.cell.com/cell/abstract/S0092-8674(15)01569-X', authors: 'Snyder, Kircher et al.', title: 'Cell-free DNA Comprises an In Vivo Nucleosome Footprint that Informs Its Tissues-Of-Origin', journal: 'Cell', year: 2016, pmid: '26771485', pdfFile: 'snyder_cell_2016.pdf' },
