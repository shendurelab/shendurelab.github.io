---
import BaseLayout from '../../layouts/BaseLayout.astro';

const centers = [
  {
    name: 'Seattle Hub for Synthetic Biology',
    url: 'https://alleninstitute.org/division/seattle-hub-for-synthetic-biology/',
    image: '/images/centers/seahub.png',
    description: 'A collaborative research initiative launched by the Allen Institute, Chan Zuckerberg Initiative, and the University of Washington to develop molecular recording technologies.',
  },
  {
    name: 'The Brotman-Baty Institute for Precision Medicine',
    url: 'https://brotmanbaty.org/',
    image: '/images/centers/bbi.png',
    description: 'A collaborative research institute between UW Medicine, Fred Hutchinson Cancer Center, and Seattle Children\'s focused on advancing precision medicine.',
  },
  {
    name: 'The Allen Discovery Center for Cell Lineage Tracing',
    image: '/images/centers/allen-family-philanthropies.png',
    largeImage: true,
    description: 'Developed and applied new technologies to trace the lineage of cells during development and disease.',
    sunset: 'We are winding down this project.',
  },
  {
    name: 'The UW Center for Nuclear Organization and Function',
    url: 'https://newsroom.uw.edu/news-releases/nih-funded-center-study-nucleome-time-and-space',
    image: '/images/centers/nih.png',
    description: 'NIH-funded center studying how the spatial organization of the genome influences gene regulation.',
  },
];
---

<BaseLayout title="Centers | Shendure Lab">
  <div class="max-w-[900px] mx-auto px-4 py-8 md:py-12">
    <h1 class="text-2xl md:text-3xl font-bold text-lab-orange mb-6 md:mb-8 text-center">Centers</h1>

    <div class="mb-8 text-center">
      <a href="/resources" class="text-lab-blue hover:underline">&larr; Back to Resources</a>
    </div>

    <div class="space-y-4 md:space-y-8">
      {centers.map(center => (
        <div class={`center-card border rounded-lg p-4 md:p-6 transition-all ${center.sunset ? 'center-card-sunset' : 'hover:border-lab-blue hover:shadow-md'}`}>
          <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
            {center.image && center.url ? (
              <a href={center.url} target="_blank" rel="noopener noreferrer" class="flex-shrink-0 flex items-center justify-center w-full md:w-64">
                <img
                  src={center.image}
                  alt={center.name}
                  class={center.largeImage ? "max-w-full h-auto object-contain" : "max-h-28 w-auto object-contain"}
                  loading="lazy"
                />
                <span class="sr-only">(opens in new tab)</span>
              </a>
            ) : center.image ? (
              <div class="flex-shrink-0 flex items-center justify-center w-full md:w-64">
                <img
                  src={center.image}
                  alt={center.name}
                  class={`${center.largeImage ? "max-w-full h-auto object-contain" : "max-h-28 w-auto object-contain"} ${center.sunset ? 'opacity-60 grayscale' : ''}`}
                  loading="lazy"
                />
              </div>
            ) : null}
            <div class="flex-grow text-center md:text-left">
              <h2 class="text-lg md:text-xl font-semibold mb-2">
                {center.url ? (
                  <a
                    href={center.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-lab-blue hover:underline"
                  >
                    {center.name}
                    <span class="sr-only">(opens in new tab)</span>
                    <svg class="inline-block w-4 h-4 ml-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ) : (
                  <span class="center-name-text">{center.name}</span>
                )}
              </h2>
              <p class="center-description text-sm md:text-base">{center.description}</p>
              {center.sunset && (
                <p class="center-sunset-notice text-sm mt-2 italic">{center.sunset}</p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <style>
    .center-card {
      background-color: white;
      border-color: #e5e7eb;
    }
    :global(.dark) .center-card {
      background-color: white;
      border-color: #4b5563;
    }
    .center-description {
      color: #4b5563;
    }
    :global(.dark) .center-description {
      color: #374151;
    }
    .center-name-text {
      color: var(--theme-text-secondary);
    }
    .center-card-sunset {
      opacity: 0.85;
    }
    .center-sunset-notice {
      color: #6b7280;
    }
    :global(.dark) .center-sunset-notice {
      color: #6b7280;
    }
  </style>
</BaseLayout>
