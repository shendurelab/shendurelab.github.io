  { date: 'Apr-20', source: 'MIT Technology Review', headline: 'The US already has the technology to test millions of people a day', url: 'https://www.technologyreview.com/2020/04/28/1000671/covid-tests-millions-per-day-crispr-biotechnology-advances/' },
  { date: 'Mar-20', source: 'Seattle Business', headline: 'Dr. Jay Shendure: The 2020 Leaders in Health Care Gold Award Winner for Achievement in Medical Research', url: 'https://seattlebusinessmag.com/leaders-healthcare/dr-jay-shendure-2020-leaders-health-care-gold-award-winner-achievement-medical' },
  { date: 'Feb-19', source: 'Allen Institute', headline: '2 million-cell experiment traces how a mammal grows, cell by single cell', url: 'https://alleninstitute.org/what-we-do/frontiers-group/news-press/articles/2-million-cell-experiment-traces-how-mammal-grows' },
  { date: 'Feb-19', source: 'GeekWire', headline: 'University of Washington researchers create massive genetic map of organ development', url: 'https://www.geekwire.com/2019/university-washington-researchers-create-massive-genetic-map-organ-development/' },
  { date: 'Jan-19', source: 'National Academy of Sciences', headline: 'Jay Shendure, University of Washington, to receive the 2019 Richard Lounsbery Award.', url: 'http://www.nasonline.org/programs/awards/2019-nas-awards/Shendure.html' },
  { date: 'Sep-18', source: 'Associated Press', headline: 'Lab test may identify dangerous gene mutations, study finds', url: 'https://apnews.com/bdfc44bd57a141c895f6758af4feefed' },
  { date: 'Sep-18', source: 'Nature', headline: 'Huge genetic-screening effort helps pinpoint roots of breast cancer', url: 'https://www.nature.com/articles/d41586-018-06665-x' },
  { date: 'Sep-18', source: 'The Atlantic', headline: 'With CRISPR, Scientists Engineered Nearly 4,000 Mutations of a Breast-Cancer Gene', url: 'https://www.theatlantic.com/science/archive/2018/09/4000-brca1-variants/569827/' },
  { date: 'Sep-18', source: 'STAT News', headline: 'Study cracks open the secrets of the cancer-causing BRCA1 gene', url: 'https://www.statnews.com/2018/09/12/brca1-cancer-gene-secrets-study/' },
  { date: 'Aug-18', source: 'HHMI News', headline: 'Cell Atlas Reveals Landscape of Open Chromatin in 100,000 Cells', url: 'https://www.hhmi.org/news/cell-atlas-reveals-landscape-of-open-chromatin-100000-cells' },
  { date: 'Dec-17', source: 'GeekWire', headline: "UW, Seattle Children's and Fred Hutch launch $50M Institute for Precision Medicine, using genetics to revolutionize health", url: 'https://www.geekwire.com/2017/50m-brotman-baty-institute-precision-medicine-launches-using-dna-code-personalize-medicine/' },
  { date: 'Dec-17', source: 'The Seattle Times', headline: 'Costco co-founder and boyhood friend give $50 million for precision medicine at UW', url: 'https://www.seattletimes.com/seattle-news/science/costco-founder-and-boyhood-friend-give-50-million-for-precision-medicine-at-uw/' },
  { date: 'Aug-17', source: 'New York Times', headline: 'A Speedier Way to Catalog Human Cells (All 37 Trillion of Them)', url: 'https://www.nytimes.com/2017/08/17/science/cells-human-body-sci-rna-seq.html' },
  { date: 'May-16', source: 'The Atlantic', headline: 'Using CRISPR to Learn How a Body Builds Itself', url: 'http://www.theatlantic.com/amp/article/484394/' },
  { date: 'Feb-16', source: "NIH Director's Blog", headline: 'A New Tool in the Toolbox: New Method Traces Free-Floating DNA Back to Its Source', url: 'https://directorsblog.nih.gov/2016/02/16/a-new-tool-in-the-toolbox-new-method-traces-free-floating-dna-back-to-its-source/' },
  { date: 'Jan-16', source: 'New York Times', headline: 'Searching for Cancer Maps in Free-Floating DNA', url: 'http://www.nytimes.com/2016/01/15/science/searching-for-cancer-maps-in-free-floating-dna.html' },
  { date: 'Oct-15', source: 'The Atlantic', headline: 'Taking the Uncertainty Out of Genetic Screening for Cancer Risk', url: 'http://www.theatlantic.com/science/archive/2015/10/filling-in-the-unknown-unknowns-of-cancer-genetic-testing/409828/' },
  { date: 'May-15', source: 'Howard Hughes Medical Research Institute', headline: "HHMI Selects 26 of the Nation's Top Biomedical Scientists", url: 'https://www.hhmi.org/news/hhmi-selects-26-nations-top-biomedical-scientists' },
  { date: 'Apr-15', source: 'Seattle Times', headline: 'UW experts shed light on false positives in prenatal tests', url: 'http://www.seattletimes.com/seattle-news/health/uw-experts-shed-light-on-false-positives-in-prenatal-tests' },
  { date: 'Mar-15', source: 'NIH News', headline: "NIH forms team of experts to chart course for the President's Precision Medicine Initiative research network", url: 'http://www.nih.gov/news/health/mar2015/od-30.htm' },
  { date: 'Jul-14', source: 'HudsonAlpha Institute for Biotechnology', headline: 'Pioneer in Next Generation Sequencing Receives 2014 HudsonAlpha Life Sciences Prize', url: 'http://hudsonalpha.org/press-releases/pioneer-in-next-generation-sequencing-receives-2014-hudsonalpha-life-sciences-prize' },
  { date: 'Jul-14', source: 'Cell', headline: 'Cell 40th Anniversary 40-under-40', url: 'http://www.cell.com/40/under40' },
  { date: 'Feb-14', source: "NIH Director's Blog", headline: 'Creative Minds: Interpreting Your Genome', url: 'http://directorsblog.nih.gov/2014/02/11/creative-minds-interpreting-your-genome/' },
  { date: 'Oct-13', source: 'Federa (Dutch)', headline: 'FederaPrijs to developer of groundbreaking DNA analysis', url: 'http://www.federa.org/prijswinnaar-federa-2013' },
  { date: 'Aug-13', source: 'New York Times', headline: 'A Family Consents to a Medical Gift, 62 Years Later', url: 'http://www.nytimes.com/2013/08/08/science/after-decades-of-research-henrietta-lacks-family-is-asked-for-consent.html' },
  { date: 'Aug-13', source: 'KUOW Weekday', headline: "What Caused Henrietta Lacks' Aggressive Cancer?", url: 'http://kuow.org/post/cancer-mystery-solved-cartoonist-ellen-forney-sleep-diet-connection-and-wagners-ring' },
  { date: 'Jul-12', source: 'American Society of Human Genetics', headline: 'ASHG Honors Dr. Jay Shendure with Curt Stern Award for 2012', url: 'http://www.ashg.org/pdf/PR_2012_CurtStern.pdf' },
  { date: 'Jun-12', source: 'KUOW 94.9 (The Conversation)', headline: 'UW Prenatal Test Could Replace Amniotic Fluid Testing', url: 'http://www2.kuow.org/program.php?id=26986' },
  { date: 'Jun-12', source: 'Los Angeles Times', headline: 'Entire DNA of fetus revealed through risk-free testing', url: 'http://www.latimes.com/news/science/la-sci-fetal-genome-sequence-20120607,0,7625263.story' },
  { date: 'Jun-12', source: 'NBC Nightly News', headline: 'Testing saliva for genetic makeup', url: 'http://video.msnbc.msn.com/nightly-news/47759272#47759272' },
  { date: 'Jun-12', source: 'New York Times', headline: 'DNA Blueprint for Fetus Built Using Tests of Parents', url: 'http://www.nytimes.com/2012/06/07/health/tests-of-parents-are-used-to-map-genes-of-a-fetus.html' },
  { date: 'Jun-12', source: 'NPR', headline: "Are Fetal DNA Tests A Key To Pandora's Box?", url: 'http://www.npr.org/2012/06/07/154533037/are-fetal-dna-tests-a-key-to-pandoras-box' },
  { date: 'May-12', source: 'HHMI Bulletin', headline: 'Exome Sequencing: Opening the Flood Gates', url: 'http://www.hhmi.org/bulletin/may2012/features/exome_sequencing.html' },
  { date: 'Apr-12', source: 'New York Times', headline: 'Scientists Link Gene Mutation to Autism Risk', url: 'http://www.nytimes.com/2012/04/05/health/research/scientists-link-rare-gene-mutations-to-heightened-risk-of-autism.html' },
  { date: 'Dec-10', source: 'Times of India', headline: 'Gujarati woman becomes first Indian to have genes mapped', url: 'http://timesofindia.indiatimes.com/city/ahmedabad/Gujarati-woman-becomes-first-Indian-to-have-genes-mapped/articleshow/7182283.cms' },
  { date: 'Nov-09', source: 'Nature News', headline: 'Selective sequencing solves a genetic mystery', url: 'http://www.nature.com/news/2009/091113/full/news.2009.1085.html' },
  { date: 'Sep-09', source: 'In Sequence', headline: "Exome Project Paper Shows Exon Sequencing's Potential for Rare Disease Research", url: 'http://www.genomeweb.com/sequencing/first-exome-project-paper-shows-exon-sequencings-potential-rare-disease-research' },
  { date: 'Sep-09', source: 'Forbes', headline: 'Cheap DNA Sequencing', url: 'http://www.forbes.com/2009/09/22/jay-shendure-dna-sequencing-technology-revolutionaries-shendure.html' },
  { date: 'Aug-09', source: 'NIH (NHLBI)', headline: 'NIH-Funded Researchers Sequence Exomes of 12 People', url: 'https://www.nih.gov/news-events/news-releases/nih-funded-researchers-sequence-exomes-12-people' },
  { date: 'Oct-06', source: 'Technology Review', headline: 'TR35: The $1,000 genome', url: 'https://www.technologyreview.com/s/406237/2006-young-innovators-under-35/' },
  { date: 'Aug-05', source: 'New York Times', headline: '2 New Methods to Sequence DNA Promise Vastly Lower Costs', url: 'http://www.nytimes.com/2005/08/09/science/09dna.html' },
];

// Group news by year
const groupedNews: Record<string, typeof newsItems> = {};
newsItems.forEach((item) => {
  const year = '20' + item.date.split('-')[1];
  if (!groupedNews[year]) groupedNews[year] = [];
  groupedNews[year].push(item);
});
const years = Object.keys(groupedNews).sort((a, b) => Number(b) - Number(a));
---

<style>
  .timeline-border {
    border-color: #e5e7eb;
  }
  .timeline-dot {
    border-color: white;
  }
  .news-meta {
    color: #6b7280;
  }
  .news-headline {
    color: #1f2937;
  }
  /* Dark mode - lighter colors for better readability */
  :global(.dark) .timeline-border {
    border-color: #4b5563;
  }
  :global(.dark) .timeline-dot {
    border-color: #1f2937;
  }
  :global(.dark) .news-meta {
    color: #d1d5db;
  }
  :global(.dark) .news-headline {
    color: #f3f4f6;
  }
</style>

<BaseLayout title="Featured News | Shendure Lab">
  <div class="max-w-[900px] mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-lab-orange mb-8 text-center">Featured News</h1>

    <div class="mb-10 text-center">
      <a href="/press/all" class="inline-flex items-center gap-2 text-lab-blue hover:underline font-medium">
        View All News
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    {years.map((year) => (
      <div class="mb-10">
        <div class="flex items-center gap-4 mb-6">
          <div class="text-2xl font-bold text-uw-purple">{year}</div>
          <div class="flex-1 h-px bg-gradient-to-r from-uw-purple/30 to-transparent"></div>
        </div>

        <div class="relative pl-6 border-l-2 timeline-border">
          {groupedNews[year].map((item) => (
            <div class="relative mb-6 last:mb-0">
              <div class="absolute -left-[25px] top-1 w-3 h-3 rounded-full bg-uw-gold border-2 timeline-dot shadow-sm"></div>
              <div class="group">
                <div class="text-xs news-meta mb-1">{item.date} · {item.source}</div>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="news-headline hover:text-lab-blue transition-colors"
                >
                  {item.headline}
                  <span class="sr-only">(opens in new tab)</span>
                  <svg class="inline-block w-3.5 h-3.5 ml-1 opacity-40 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>
