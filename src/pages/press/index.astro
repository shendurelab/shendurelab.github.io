  { date: 'Dec-23', source: 'PR Newswire', headline: 'Seattle Hub for Synthetic Biology launched by Allen Institute, Chan Zuckerberg Initiative, and the University of Washington will turn cells into recording devices to unlock secrets of disease', url: 'https://www.prnewswire.com/news-releases/seattle-hub-for-synthetic-biology-launched-by-allen-institute-chan-zuckerberg-initiative-and-the-university-of-washington-will-turn-cells-into-recording-devices-to-unlock-secrets-of-disease-302005426.html' },
  { date: 'Dec-23', source: 'GeekWire', headline: 'Seattle Hub for Synthetic Biology plans to transform cells into tiny recording devices', url: 'https://www.geekwire.com/2023/seattle-hub-for-synthetic-biology-recording-cells/' },
  { date: 'Dec-23', source: 'Chan Zuckerberg Initiative', headline: 'Seattle Hub for Synthetic Biology Launched By Allen Institute, Chan Zuckerberg Initiative, And The University Of Washington Will Turn Cells Into Recording Devices To Unlock Secrets Of Disease', url: 'https://chanzuckerberg.com/newsroom/seattle-hub-for-synthetic-biology-launches/' },
  { date: 'Dec-23', source: 'TechCrunch', headline: "Seattle biotech hub pursues 'DNA typewriter' tech with $75M from tech billionaires", url: 'https://techcrunch.com/2023/12/07/seattle-biotech-hub-pursues-dna-typewriter-tech-with-75m-from-tech-billionaires/' },
  { date: 'Jul-22', source: 'Allen Institute', headline: "DNA Typewriter keeps a record of cell's long histories", url: 'https://alleninstitute.org/what-we-do/frontiers-group/news-press/articles/dna-typewriter-keeps-record-cells-long-histories' },
