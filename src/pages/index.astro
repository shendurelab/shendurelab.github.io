---
import HomeLayout from '../layouts/HomeLayout.astro';
---

<HomeLayout title="Home" description="Shendure Lab - Developing and applying new technologies for DNA sequencing, genome function, and human genetics.">

  <!-- Hero Section -->
  <div class="hero-content">
    <h1 class="hero-logo">
      <span class="hero-shendure">shendure</span><span class="hero-lab">lab</span>
    </h1>
    <p class="hero-tagline">Department of Genome Sciences &middot; University of Washington</p>

    <div class="hero-ctas">
      <a href="/research" class="hero-btn hero-btn-primary">
        Our Research
      </a>
      <a href="/publications" class="hero-btn hero-btn-secondary">
        Publications
      </a>
    </div>
  </div>

  <style>
    .hero-content {
      position: relative;
      text-align: center;
      padding: 3rem 4rem;
    }

    .hero-content::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 120%;
      height: 200%;
      background: radial-gradient(ellipse at center, rgba(10, 14, 20, 0.8) 0%, rgba(10, 14, 20, 0.4) 40%, transparent 70%);
      pointer-events: none;
      z-index: -1;
    }

    .hero-logo {
      font-family: 'JetBrains Mono', monospace;
      font-size: clamp(3rem, 10vw, 6rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 1rem;
      text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
    }

    .hero-shendure {
      color: #ffffff;
    }

    .hero-lab {
      color: #3b82f6;
      text-shadow: 0 4px 30px rgba(59, 130, 246, 0.3);
    }

    .hero-tagline {
      color: rgba(255, 255, 255, 0.45);
      font-size: 0.95rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8);
      margin-bottom: 2.5rem;
    }

    .hero-ctas {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }

    .hero-btn {
      display: inline-block;
      padding: 0.75rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 0.5rem;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .hero-btn-primary {
      background: rgba(59, 130, 246, 0.9);
      color: #ffffff;
      border: 1px solid rgba(59, 130, 246, 0.5);
    }

    .hero-btn-primary:hover {
      background: rgba(59, 130, 246, 1);
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
    }

    .hero-btn-secondary {
      background: transparent;
      color: rgba(255, 255, 255, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .hero-btn-secondary:hover {
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.5);
      background: rgba(255, 255, 255, 0.05);
    }

    .hero-btn:focus-visible {
      outline: 2px solid rgba(255, 255, 255, 0.6);
      outline-offset: 2px;
    }

    @media (max-width: 600px) {
      .hero-content {
        padding: 2rem 1rem;
      }

      .hero-tagline {
        font-size: 0.75rem;
        letter-spacing: 0.08em;
      }

      .hero-btn {
        padding: 0.65rem 1.5rem;
        font-size: 0.875rem;
      }
    }
  </style>

</HomeLayout>
