---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="max-w-[600px] mx-auto px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-lab-orange mb-4">404</h1>
    <p class="text-xl page-subtitle mb-8">Page not found</p>
    <p class="page-text mb-10">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-block px-6 py-3 bg-lab-orange-dark text-white font-semibold rounded-lg hover:bg-lab-orange transition-colors"
    >
      Back to Home
    </a>
  </div>

  <style>
    .page-subtitle {
      color: var(--theme-text-secondary);
    }
    .page-text {
      color: var(--theme-text-muted);
    }
  </style>
</BaseLayout>
